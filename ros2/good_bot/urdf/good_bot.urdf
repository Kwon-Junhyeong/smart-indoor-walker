<?xml version="1.0"?>
<robot name="good_bot">

  <material name="grey"> <color rgba="0.7 0.7 0.7 1"/> </material>
  <material name="dark_grey"> <color rgba="0.3 0.3 0.3 1"/> </material>
  <material name="black"> <color rgba="0.1 0.1 0.1 1"/> </material>
  <material name="red"> <color rgba="0.8 0 0 1"/> </material>
  <material name="orange"> <color rgba="1 0.5 0 1"/> </material>

  <link name="base_link">
    
    <visual>
      <origin xyz="0.125 0.14 0.1" rpy="0 0 0"/> 
      <geometry> <box size="0.3 0.02 0.02"/> </geometry> 
      <material name="grey"/>
    </visual>

    <visual>
      <origin xyz="0.125 -0.14 0.1" rpy="0 0 0"/>
      <geometry> <box size="0.3 0.02 0.02"/> </geometry>
      <material name="grey"/>
    </visual>

    <visual>
      <origin xyz="0.265 0 0.1" rpy="0 0 0"/> 
      <geometry> <box size="0.02 0.3 0.02"/> </geometry>
      <material name="grey"/>
    </visual>

    <visual>
      <origin xyz="0.225 0.14 0.25" rpy="0 0 0"/> 
      <geometry> <cylinder length="0.3" radius="0.01"/> </geometry> 
      <material name="grey"/>
    </visual>

    <visual>
      <origin xyz="0.225 -0.14 0.25" rpy="0 0 0"/>
      <geometry> <cylinder length="0.3" radius="0.01"/> </geometry>
      <material name="grey"/>
    </visual>

    <visual>
      <origin xyz="0.15 0.14 0.4" rpy="0 1.57 -0.1"/> 
      <geometry> <cylinder length="0.15" radius="0.01"/> </geometry> 
      <material name="black"/>
    </visual>

    <visual>
      <origin xyz="0.15 -0.14 0.4" rpy="0 1.57 0.1"/>
      <geometry> <cylinder length="0.15" radius="0.01"/> </geometry>
      <material name="black"/>
    </visual>

    <visual>
      <origin xyz="0 0 0.32" rpy="0 0 0"/> 
      <geometry> <box size="0.01 0.22 0.1"/> </geometry>
      <material name="dark_grey"/>
    </visual>

    <visual>
      <origin xyz="0.1 0 0.22" rpy="0 0 0"/> 
      <geometry> <box size="0.2 0.22 0.02"/> </geometry>
      <material name="dark_grey"/>
    </visual>

    </link>

  <link name="left_wheel">
    <visual>
      <geometry> <cylinder length="0.02" radius="0.0375"/> </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.15 0.0375" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry> <cylinder length="0.02" radius="0.0375"/> </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.15 0.0375" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <geometry> <cylinder length="0.02" radius="0.0375"/> </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="front_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.265 0.15 0.0375" rpy="-1.57 0 0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <geometry> <cylinder length="0.02" radius="0.0375"/> </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="front_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.265 -0.15 0.0375" rpy="-1.57 0 0"/>
  </joint>


  <link name="laser_frame">
    <visual>
      <geometry> <cylinder length="0.02" radius="0.0175"/> </geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.25 0 0.13" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry> <box size="0.01 0.01 0.002"/> </geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.25 0 0.115" rpy="0 0 0"/>
  </joint>

</robot>
